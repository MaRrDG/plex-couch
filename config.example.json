{
  "_comment": "Copy to config.local.json next to plex-couch.exe (or pass --config). pin_hash and secret are written by the app (--set-pin / first run). Leave api_key/token empty to read them from the service config files or the registry at runtime. Empty strings in jobs mean the built-in default.",
  "app_name": "Plex Couch",
  "settings": {
    "auto_monitors_off": true
  },
  "filelist_tracker_regex": "thefl\\.org|filelist\\.(io|ro)|flro\\.org",
  "disks": ["C:", "D:"],
  "plex_poll_seconds": 10,
  "allowed_hosts": [],
  "notifications": {
    "server": "https://ntfy.sh",
    "topic": null,
    "disk_min_gb": 60,
    "ready_wait_minutes": 20
  },
  "https": {
    "port": 8766,
    "cert": "certs/server.pem",
    "key": "certs/server.key",
    "ca_cert": "certs/ca.crt"
  },
  "services": {
    "plex": {
      "url": "http://127.0.0.1:32400",
      "token": "",
      "token_registry_key": "Software\\Plex, Inc.\\Plex Media Server",
      "token_registry_value": "PlexOnlineToken"
    },
    "radarr": {
      "url": "http://127.0.0.1:7878",
      "api_key": "",
      "config_xml": "C:\\ProgramData\\Radarr\\config.xml"
    },
    "sonarr": {
      "url": "http://127.0.0.1:8989",
      "api_key": "",
      "config_xml": "C:\\ProgramData\\Sonarr\\config.xml"
    },
    "bazarr": {
      "url": "http://127.0.0.1:6767",
      "api_key": "",
      "config_yaml": "C:\\ProgramData\\Bazarr\\config\\config.yaml"
    },
    "prowlarr": {
      "url": "http://127.0.0.1:9696"
    },
    "qbittorrent": {
      "url": "http://127.0.0.1:8080",
      "username": "",
      "password": ""
    }
  },
  "jobs": {
    "watchlist": {
      "discover_url": "https://discover.provider.plex.tv"
    },
    "strip_dv": {
      "ffmpeg_bin": "",
      "ffmpeg_packages": "",
      "tmp_dir": "D:\\Media\\Downloads\\.strip-dv",
      "log": "D:\\Media\\scripts\\logs\\strip-dv.log",
      "seen": "D:\\Media\\scripts\\logs\\strip-dv-seen.txt",
      "libraries": [
        {"path": "D:\\Media\\Movies", "arr": "radarr", "section": 1},
        {"path": "D:\\Media\\Seriale", "arr": "sonarr", "section": 2}
      ]
    },
    "seed_keeper": {
      "downloads_root": "D:\\Media\\Downloads"
    },
    "convert": {
      "ffmpeg_bin": "",
      "tmp_dir": "D:\\Media\\Downloads\\.reencode",
      "section": 2
    }
  }
}
